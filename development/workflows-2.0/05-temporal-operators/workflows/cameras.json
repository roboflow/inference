{
  "version": "2.0",
  "sources": [
    {"type": "temporal_demo/tensor_camera", "name": "left", "schedule": "left"},
    {"type": "temporal_demo/tensor_camera", "name": "right", "schedule": "right"}
  ],
  "operators": [
    {
      "type": "v2/align@v1", "name": "rig",
      "inputs": {"left": "$sources.left.image", "right": "$sources.right.image"},
      "clock": "rig-media", "coverage": "media", "tolerance_ms": 10, "layout": "batch"
    },
    {
      "type": "v2/window@v1", "name": "clip",
      "collect": {"frames": "$operators.rig.samples"},
      "hold": {"reference": "$steps.grey_card.image"},
      "size": 3, "partial": "drop"
    }
  ],
  "steps": [
    {"type": "temporal_demo/grey_card", "name": "grey_card", "image": "$operators.rig.samples", "value": 128},
    {"type": "v2/best_frame", "name": "best", "frames": "$operators.clip.frames", "reference": "$operators.clip.reference"},
    {"type": "temporal_demo/clip_ends", "name": "ends", "frames": "$operators.clip.frames"}
  ],
  "outputs": [
    {
      "type": "OutputGroup", "name": "pairs", "anchor": "$operators.rig.samples",
      "outputs": [{"type": "JsonField", "name": "samples", "selector": "$operators.rig.samples"}]
    },
    {
      "type": "OutputGroup", "name": "clips", "anchor": "$operators.clip.frames",
      "outputs": [
        {"type": "JsonField", "name": "frames", "selector": "$operators.clip.frames"},
        {"type": "JsonField", "name": "first", "selector": "$steps.ends.first"},
        {"type": "JsonField", "name": "last", "selector": "$steps.ends.last"},
        {"type": "JsonField", "name": "best", "selector": "$steps.best.frame"},
        {"type": "JsonField", "name": "count", "selector": "$steps.ends.count"}
      ]
    }
  ]
}
