{
  "version": "2.0",
  "sources": [
    {"type": "temporal_demo/tensor_camera", "name": "left", "schedule": "left"},
    {"type": "temporal_demo/tensor_camera", "name": "right", "schedule": "right"}
  ],
  "operators": [
    {
      "type": "v2/align@v1", "name": "rig",
      "inputs": {"left": "$sources.left.image", "right": "$sources.right.image"},
      "clock": "rig-media", "tolerance_ms": 10, "layout": "batch"
    },
    {"type": "v2/window@v1", "name": "clip", "collect": {"frames": "$operators.rig.samples"}, "size": 3},
    {"type": "v2/window@v1", "name": "clips_of_clips", "collect": {"clips": "$operators.clip.frames"}, "size": 2}
  ],
  "outputs": [
    {
      "type": "OutputGroup", "name": "results", "anchor": "$operators.clips_of_clips.clips",
      "outputs": [{"type": "JsonField", "name": "clips", "selector": "$operators.clips_of_clips.clips"}]
    }
  ]
}
