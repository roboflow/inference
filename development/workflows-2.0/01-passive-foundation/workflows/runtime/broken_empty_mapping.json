{
  "version": "2.0",
  "inputs": [
    {
      "name": "values",
      "kind": "number",
      "axes": [{"id": "samples", "kind": "sample", "stationary": true}]
    }
  ],
  "steps": [
    {
      "name": "broken",
      "type": "demo/broken",
      "value": "$inputs.values",
      "mode": "empty_mapping"
    },
    {"name": "scale", "type": "demo/scale", "value": "$inputs.values", "factor": 2}
  ],
  "outputs": [
    {"type": "JsonField", "name": "out", "selector": "$steps.broken.value"},
    {"type": "JsonField", "name": "sibling", "selector": "$steps.scale.scaled"}
  ]
}
