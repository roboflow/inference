{
  "version": "2.0",
  "inputs": [
    {
      "name": "images",
      "kind": "image",
      "axes": [{"id": "samples", "kind": "sample", "stationary": true}]
    }
  ],
  "steps": [
    {
      "name": "crop",
      "type": "v2/crop",
      "inputs": {"image": "$inputs.images"},
      "config": {"regions": [[40, 40, 100, 100], [120, 10, 180, 70]]}
    },
    {
      "name": "invert",
      "type": "v2/invert",
      "inputs": {"image": "$steps.crop.crops"},
      "config": {}
    },
    {
      "name": "mosaic",
      "type": "v2/mosaic",
      "inputs": {"images": "$steps.invert.image"},
      "config": {"tile_size": 48, "background": 128}
    },
    {
      "name": "mosaic_all",
      "type": "v2/mosaic",
      "inputs": {"images": "$inputs.images"},
      "config": {"tile_size": 96}
    }
  ],
  "outputs": [
    {"name": "crops", "selector": "$steps.crop.crops"},
    {"name": "summary", "selector": "$steps.crop.summary"},
    {"name": "inverted", "selector": "$steps.invert.image"},
    {"name": "mosaic", "selector": "$steps.mosaic.image"},
    {"name": "mosaic_count", "selector": "$steps.mosaic.count"},
    {"name": "mosaic_all", "selector": "$steps.mosaic_all.image"},
    {"name": "mosaic_all_count", "selector": "$steps.mosaic_all.count"}
  ]
}
