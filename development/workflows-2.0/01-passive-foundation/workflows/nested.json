{
  "version": "2.0",
  "inputs": [
    {
      "name": "images",
      "kind": "image",
      "axes": [{"id": "samples", "kind": "sample", "stationary": true}]
    }
  ],
  "steps": [
    {
      "name": "crop",
      "type": "v2/crop",
      "image": "$inputs.images",
      "regions": [[40, 40, 100, 100], [120, 10, 180, 70]]
    },
    {"name": "invert", "type": "v2/invert", "image": "$steps.crop.crops"},
    {
      "name": "mosaic",
      "type": "v2/mosaic",
      "images": "$steps.invert.image",
      "tile_size": 48,
      "background": 128
    },
    {
      "name": "mosaic_all",
      "type": "v2/mosaic",
      "images": "$inputs.images",
      "tile_size": 96
    }
  ],
  "outputs": [
    {"type": "JsonField", "name": "crops", "selector": "$steps.crop.crops"},
    {"type": "JsonField", "name": "summary", "selector": "$steps.crop.summary"},
    {"type": "JsonField", "name": "inverted", "selector": "$steps.invert.image"},
    {"type": "JsonField", "name": "mosaic", "selector": "$steps.mosaic.image"},
    {"type": "JsonField", "name": "mosaic_count", "selector": "$steps.mosaic.count"},
    {"type": "JsonField", "name": "mosaic_all", "selector": "$steps.mosaic_all.image"},
    {
      "type": "JsonField",
      "name": "mosaic_all_count",
      "selector": "$steps.mosaic_all.count"
    }
  ]
}
