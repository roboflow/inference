{
  "version": "2.0",
  "inputs": [
    {
      "name": "images",
      "kind": "image",
      "axes": [{"id": "samples", "kind": "sample", "stationary": true}]
    }
  ],
  "steps": [
    {
      "name": "crop",
      "type": "v2/crop",
      "image": "$inputs.images",
      "regions": [[40, 40, 100, 100], [120, 10, 180, 70]]
    }
  ],
  "outputs": [{"type": "JsonField", "name": "out", "selector": "$steps.crop.crops"}],
  "sources": []
}
