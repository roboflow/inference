{
  "version": "2.0",
  "inputs": [
    {
      "name": "images",
      "kind": "image",
      "axes": [
        {
          "id": "samples",
          "kind": "sample",
          "stationary": true
        },
        {
          "id": "frames",
          "kind": "time"
        }
      ]
    }
  ],
  "steps": [
    {
      "name": "mosaic",
      "type": "v2/mosaic",
      "inputs": {
        "images": "$inputs.images"
      },
      "config": {}
    }
  ],
  "outputs": [
    {
      "name": "out",
      "selector": "$steps.mosaic.image"
    }
  ]
}
