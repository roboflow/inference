{
  "version": "2.0",
  "inputs": [
    {
      "name": "images",
      "kind": "image",
      "axes": [
        {
          "id": "samples",
          "kind": "sample",
          "stationary": true
        }
      ]
    }
  ],
  "steps": [
    {
      "name": "crop",
      "type": "v2/crop",
      "inputs": {
        "image": "$inputs.images"
      },
      "config": {
        "regions": [
          [
            40,
            40,
            100,
            100
          ],
          [
            120,
            10,
            180,
            70
          ]
        ]
      }
    },
    {
      "name": "invert",
      "type": "v2/invert",
      "inputs": {
        "image": "$steps.crop.crops"
      },
      "config": {},
      "when": "$steps.crop.summary"
    }
  ],
  "outputs": [
    {
      "name": "out",
      "selector": "$steps.invert.image"
    }
  ]
}
