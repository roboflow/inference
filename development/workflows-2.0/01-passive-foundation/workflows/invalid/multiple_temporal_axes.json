{
  "version": "2.0",
  "inputs": [
    {
      "name": "images",
      "kind": "image",
      "axes": [
        {"id": "samples", "kind": "sample", "stationary": true},
        {"id": "frames", "kind": "time"},
        {"id": "clips", "kind": "time"}
      ]
    }
  ],
  "steps": [{"name": "mosaic", "type": "v2/mosaic", "images": "$inputs.images"}],
  "outputs": [{"type": "JsonField", "name": "out", "selector": "$steps.mosaic.image"}]
}
