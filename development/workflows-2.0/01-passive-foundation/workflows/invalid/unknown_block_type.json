{
  "version": "2.0",
  "inputs": [
    {
      "name": "images",
      "kind": "image",
      "axes": [
        {
          "id": "samples",
          "kind": "sample",
          "stationary": true
        }
      ]
    }
  ],
  "steps": [
    {
      "name": "crop",
      "type": "v2/does_not_exist",
      "inputs": {
        "image": "$inputs.images"
      },
      "config": {}
    }
  ],
  "outputs": [
    {
      "name": "out",
      "selector": "$steps.crop.crops"
    }
  ]
}
