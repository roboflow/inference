{
  "version": "2.0",
  "inputs": [
    {
      "name": "images",
      "kind": "image",
      "axes": [{"id": "samples", "kind": "sample", "stationary": true}]
    }
  ],
  "steps": [
    {
      "name": "crop",
      "type": "v2/crop",
      "inputs": {"image": "$inputs.images"},
      "config": {"regions": [[40, 40, 100, 100], [120, 10, 180, 70]]}
    },
    {
      "name": "keep",
      "type": "v2/has_brightness",
      "inputs": {"image": "$steps.crop.crops"},
      "config": {"minimum": 100}
    },
    {
      "name": "invert",
      "type": "v2/invert",
      "inputs": {"image": "$steps.crop.crops"},
      "config": {},
      "when": "$steps.keep.keep"
    },
    {
      "name": "mosaic",
      "type": "v2/mosaic",
      "inputs": {"images": "$steps.invert.image"},
      "config": {"tile_size": 48, "background": 128}
    },
    {
      "name": "mosaic_unfiltered",
      "type": "v2/mosaic",
      "inputs": {"images": "$steps.crop.crops"},
      "config": {"tile_size": 48, "background": 128}
    }
  ],
  "outputs": [
    {"name": "crops", "selector": "$steps.crop.crops"},
    {"name": "keep", "selector": "$steps.keep.keep"},
    {"name": "inverted", "selector": "$steps.invert.image"},
    {"name": "mosaic", "selector": "$steps.mosaic.image"},
    {"name": "mosaic_count", "selector": "$steps.mosaic.count"},
    {"name": "mosaic_unfiltered", "selector": "$steps.mosaic_unfiltered.image"},
    {"name": "mosaic_unfiltered_count", "selector": "$steps.mosaic_unfiltered.count"}
  ]
}
