{
  "version": "2.0",
  "inputs": [
    {
      "name": "values",
      "kind": "number",
      "axes": [{"id": "samples", "kind": "sample", "stationary": true}]
    }
  ],
  "steps": [
    {"name": "scale_root", "type": "demo/scale", "value": "$inputs.values", "factor": 2},
    {
      "name": "expand",
      "type": "demo/expand",
      "value": "$inputs.values",
      "offsets": [1, 2],
      "limit": 31
    },
    {
      "name": "scale",
      "type": "demo/scale",
      "value": "$steps.expand.children",
      "factor": 2
    },
    {
      "name": "reduce",
      "type": "demo/sum_with_parent",
      "parent": "$inputs.values",
      "children": "$steps.expand.children",
      "parent_weight": 0
    },
    {
      "name": "reduce_with_parent",
      "type": "demo/sum_with_parent",
      "parent": "$inputs.values",
      "children": "$steps.scale.scaled",
      "parent_weight": 1
    },
    {
      "name": "expand_deep",
      "type": "demo/expand",
      "value": "$steps.scale.scaled",
      "offsets": [1],
      "limit": 60
    },
    {
      "name": "scale_deep",
      "type": "demo/scale",
      "value": "$steps.expand_deep.children",
      "factor": 3
    },
    {
      "name": "reduce_deep",
      "type": "demo/sum_with_parent",
      "parent": "$steps.scale.scaled",
      "children": "$steps.scale_deep.scaled",
      "parent_weight": 1
    },
    {
      "name": "reduce_twice",
      "type": "demo/sum_with_parent",
      "parent": "$inputs.values",
      "children": "$steps.reduce_deep.total",
      "parent_weight": 0
    }
  ],
  "outputs": [
    {"type": "JsonField", "name": "scaled_root", "selector": "$steps.scale_root.scaled"},
    {"type": "JsonField", "name": "children", "selector": "$steps.expand.children"},
    {"type": "JsonField", "name": "scaled", "selector": "$steps.scale.scaled"},
    {"type": "JsonField", "name": "sums", "selector": "$steps.reduce.total"},
    {"type": "JsonField", "name": "counts", "selector": "$steps.reduce.count"},
    {
      "type": "JsonField",
      "name": "with_parent",
      "selector": "$steps.reduce_with_parent.total"
    },
    {
      "type": "JsonField",
      "name": "deep_children",
      "selector": "$steps.expand_deep.children"
    },
    {"type": "JsonField", "name": "deep_scaled", "selector": "$steps.scale_deep.scaled"},
    {"type": "JsonField", "name": "deep_totals", "selector": "$steps.reduce_deep.total"},
    {"type": "JsonField", "name": "deep_counts", "selector": "$steps.reduce_deep.count"},
    {
      "type": "JsonField",
      "name": "twice_reduced",
      "selector": "$steps.reduce_twice.total"
    }
  ]
}
