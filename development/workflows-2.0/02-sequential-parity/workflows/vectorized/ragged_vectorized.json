{
  "version": "2.0",
  "inputs": [{"type": "WorkflowBatchInput", "name": "roots"}],
  "steps": [
    {"type": "fixture/ragged_expand@v1", "name": "expand", "value": "$inputs.roots"},
    {
      "type": "capability/counting_batch_consumer@v1",
      "name": "consumer",
      "item": "$steps.expand.value"
    }
  ],
  "outputs": [
    {"type": "JsonField", "name": "result", "selector": "$steps.consumer.result"}
  ]
}
