{
  "version": "2.0",
  "inputs": [],
  "steps": [
    {"type": "capability/generate@v1", "name": "left", "values": [10, 20]},
    {"type": "capability/generate@v1", "name": "right", "values": [100, 200]},
    {
      "type": "capability/pair@v1",
      "name": "pair",
      "left": "$steps.left.value",
      "right": "$steps.right.value"
    }
  ],
  "outputs": [{"type": "JsonField", "name": "pair", "selector": "$steps.pair.pair"}]
}
