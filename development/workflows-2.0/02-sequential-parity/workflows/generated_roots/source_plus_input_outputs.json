{
  "version": "2.0",
  "inputs": [{"type": "WorkflowBatchInput", "name": "items"}],
  "steps": [
    {"type": "capability/generate@v1", "name": "source", "values": [10, 20, 30]},
    {"type": "fixture/echo@v1", "name": "item", "value": "$inputs.items"}
  ],
  "outputs": [
    {"type": "JsonField", "name": "generated", "selector": "$steps.source.value"},
    {"type": "JsonField", "name": "item", "selector": "$steps.item.value"}
  ]
}
