{
  "version": "1.0",
  "inputs": [
    {
      "type": "WorkflowImage",
      "name": "image"
    }
  ],
  "steps": [
    {
      "type": "roboflow_core/roboflow_object_detection_model@v3",
      "name": "detection_640",
      "images": "$inputs.image",
      "model_id": "yolov8n-640"
    },
    {
      "type": "roboflow_core/roboflow_object_detection_model@v3",
      "name": "detection_1280",
      "images": "$inputs.image",
      "model_id": "yolov8n-1280"
    },
    {
      "type": "roboflow_core/model_comparison_visualization@v1",
      "name": "visualization",
      "image": "$inputs.image",
      "predictions_a": "$steps.detection_640.predictions",
      "predictions_b": "$steps.detection_1280.predictions"
    }
  ],
  "outputs": [
    {
      "type": "JsonField",
      "name": "predictions_640",
      "selector": "$steps.detection_640.predictions"
    },
    {
      "type": "JsonField",
      "name": "predictions_1280",
      "selector": "$steps.detection_1280.predictions"
    },
    {
      "type": "JsonField",
      "name": "visualization",
      "coordinates_system": "own",
      "selector": "$steps.visualization.image"
    }
  ]
}
