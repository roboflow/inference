{
  "version": "1.0",
  "inputs": [
    {
      "type": "WorkflowImage",
      "name": "image"
    }
  ],
  "steps": [
    {
      "type": "roboflow_core/roboflow_instance_segmentation_model@v4",
      "name": "segmentation",
      "images": "$inputs.image",
      "model_id": "microsoft-coco-instance-segmentation/1",
      "mask_decode_mode": "fast"
    },
    {
      "type": "roboflow_core/mask_visualization@v1",
      "name": "visualization",
      "image": "$inputs.image",
      "predictions": "$steps.segmentation.predictions"
    }
  ],
  "outputs": [
    {
      "type": "JsonField",
      "name": "predictions",
      "selector": "$steps.segmentation.predictions"
    },
    {
      "type": "JsonField",
      "name": "visualization",
      "coordinates_system": "own",
      "selector": "$steps.visualization.image"
    }
  ]
}
