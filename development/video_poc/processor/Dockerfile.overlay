# check=skip=InvalidDefaultArgInFrom
# Thin experiment image layered on an already-proven processor image.
#
# This deliberately avoids rebuilding from the mutable inference-server
# `latest` tags when the experiment only changes POC worker files. Pass the
# exact deployed processor tag or digest as BASE_PROCESSOR_IMAGE and publish
# the result under an immutable commit-derived tag.
ARG BASE_PROCESSOR_IMAGE
FROM ${BASE_PROCESSOR_IMAGE}

ARG VIDEO_PROC_GIT_SHA
ARG VIDEO_PROC_RUNTIME_VARIANT=telemetry-overlay

WORKDIR /app
COPY processor.py /app/processor.py
COPY processor_metrics.py /app/processor_metrics.py
COPY job_telemetry.py /app/job_telemetry.py
COPY worker_lifecycle.py /app/worker_lifecycle.py
COPY execution_domains.py /app/execution_domains.py
COPY workspace_model_managers.py /app/workspace_model_managers.py
COPY security.py /app/security.py
COPY low_latency_producer.py /app/low_latency_producer.py

ENV VIDEO_PROC_GIT_SHA=${VIDEO_PROC_GIT_SHA}
ENV VIDEO_PROC_RUNTIME_VARIANT=${VIDEO_PROC_RUNTIME_VARIANT}

ENTRYPOINT ["python", "/app/processor.py"]
